{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/server.ts",
    "start": "tsx --tsconfig tsconfig.json src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.json src/db/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.json src/seed/run.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/vercel.js --external:pg --external:hono --external:drizzle-orm --external:zod --external:@hono/* --external:@electric-sql/*",
    "vercel-build": "npm run db:seed && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-postgis": "^0.2.17",
    "@hono/node-server": "^2.1.9",
    "@hono/zod-validator": "^0.9.1",
    "@notension/shared": "*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "esbuild": "^0.28.2"
  }
}
