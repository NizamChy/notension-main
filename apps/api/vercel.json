{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
